## BandHub — Variables de Entorno
## Copiá este archivo como .env y completá los valores

## ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=bandhub_db
POSTGRES_USER=bandhub_user
POSTGRES_PASSWORD=changeme_postgres

## ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis

## ── MinIO ───────────────────────────────────────────────────
MINIO_ROOT_USER=bandhub_minio
MINIO_ROOT_PASSWORD=changeme_minio

## ── Backend / JWT ───────────────────────────────────────────
JWT_SECRET=changeme_jwt_secret_must_be_at_least_64_chars_for_hs512_algorithm_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

## ── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

## ── Spring Profile ──────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
